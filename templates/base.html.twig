<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}DarTech{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        <style>
            :root {
                color-scheme: light dark;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                background-color: #f5f5f5;
                color: #111827;
            }
            .layout {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }
            .layout-header {
                background: #111827;
                color: #f9fafb;
                padding: 0.75rem 1.25rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .layout-brand {
                font-weight: 600;
                font-size: 1rem;
                letter-spacing: 0.03em;
            }
            .layout-main {
                flex: 1;
                max-width: 1200px;
                margin: 1.5rem auto 2.5rem;
                padding: 0 1rem;
            }
            .admin-nav {
                display: flex;
                gap: 0.75rem;
                align-items: center;
                font-size: 0.875rem;
            }
            .admin-nav__label {
                opacity: 0.7;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }
            .admin-nav a {
                color: #e5e7eb;
                text-decoration: none;
                padding: 0.25rem 0.5rem;
                border-radius: 999px;
                border: 1px solid transparent;
            }
            .admin-nav a:hover {
                background: rgba(249, 250, 251, 0.06);
                border-color: rgba(249, 250, 251, 0.12);
            }
        </style>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="layout">
            <header class="layout-header">
                <div class="layout-brand">
                    DarTech Marketplace
                </div>

                {% if is_granted('ROLE_ADMIN') %}
                    <nav class="admin-nav" aria-label="Admin navigation">
                        <span class="admin-nav__label">Admin</span>
                        <a href="{{ path('admin_dashboard') }}">Dashboard</a>
                        <a href="{{ path('admin_artisans_list') }}">Artisans</a>
                        <a href="{{ path('admin_services_list') }}">Services</a>
                    </nav>
                {% endif %}
            </header>

            <main class="layout-main">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
