{% extends 'base.html.twig' %}

{% block title %}Admin • Avis{% endblock %}

{% block body %}
  <main style="font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,'Helvetica Neue',Arial,sans-serif;margin:24px;line-height:1.45;">
    <header style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:12px;flex-wrap:wrap;">
      <div>
        <h1 style="font-size:22px;margin:0 0 4px;">Avis clients</h1>
        <p style="margin:0;color:#666;font-size:14px;">
          Vue interne de modération des avis liés aux réservations.
        </p>
      </div>
      <nav style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/admin/dashboard" style="padding:6px 10px;border-radius:999px;border:1px solid #ddd;text-decoration:none;color:#333;font-size:13px;">Dashboard</a>
        <a href="/admin/artisans" style="padding:6px 10px;border-radius:999px;border:1px solid #ddd;text-decoration:none;color:#333;font-size:13px;">Artisans</a>
        <a href="/admin/services" style="padding:6px 10px;border-radius:999px;border:1px solid #ddd;text-decoration:none;color:#333;font-size:13px;">Services</a>
        <a href="/admin/reviews" style="padding:6px 10px;border-radius:999px;border:1px solid #222;background:#222;color:#fff;text-decoration:none;font-size:13px;">Avis</a>
        <a href="/admin/disputes" style="padding:6px 10px;border-radius:999px;border:1px solid #ddd;text-decoration:none;color:#333;font-size:13px;">Litiges</a>
      </nav>
    </header>

    <section style="margin-bottom:16px;">
      <form method="get" action="" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;">
        <label style="display:flex;flex-direction:column;font-size:12px;color:#333;">
          Status
          <select name="status" style="padding:6px 8px;border:1px solid #ccc;border-radius:6px;min-width:140px;">
            <option value="">Tous</option>
            <option value="pending" {% if filters.status is defined and filters.status == 'pending' %}selected{% endif %}>En attente</option>
            <option value="approved" {% if filters.status is defined and filters.status == 'approved' %}selected{% endif %}>Approuvé</option>
            <option value="rejected" {% if filters.status is defined and filters.status == 'rejected' %}selected{% endif %}>Rejeté</option>
          </select>
        </label>
        <label style="display:flex;flex-direction:column;font-size:12px;color:#333;">
          Email client
          <input type="text" name="client" value="{{ filters.client|default('')|e }}" style="padding:6px 8px;border:1px solid #ccc;border-radius:6px;min-width:200px;">
        </label>
        <label style="display:flex;flex-direction:column;font-size:12px;color:#333;">
          Limite
          <input type="number" name="limit" min="1" max="200" value="{{ pagination.limit|default(50) }}" style="padding:6px 8px;border:1px solid #ccc;border-radius:6px;min-width:80px;">
        </label>
        <button type="submit" style="padding:8px 12px;border-radius:8px;border:1px solid #222;background:#222;color:#fff;cursor:pointer;font-size:13px;">
          Filtrer
        </button>
        {% if filters.status is defined and filters.status or filters.client is defined and filters.client %}
          <a href="?limit={{ pagination.limit|default(50) }}" style="font-size:13px;color:#666;text-decoration:none;">Réinitialiser les filtres</a>
        {% endif %}
      </form>
    </section>

    <section>
      <table style="width:100%;border-collapse:collapse;margin-top:8px;font-size:13px;">
        <thead>
          <tr>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">ID</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Booking</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Client</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Artisan</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:center;">Note</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Commentaire</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Status</th>
            <th style="border:1px solid #eee;padding:8px 10px;text-align:left;">Créé le</th>
          </tr>
        </thead>
        <tbody>
        {% for review in reviews %}
          <tr>
            <td style="border:1px solid #eee;padding:8px 10px;white-space:nowrap;font-family:monospace;font-size:12px;">{{ review.id }}</td>
            <td style="border:1px solid #eee;padding:8px 10px;">
              <span style="display:inline-block;padding:2px 6px;border-radius:999px;border:1px solid #ddd;font-size:11px;">
                #{{ review.bookingId ?? '—' }}
              </span>
            </td>
            <td style="border:1px solid #eee;padding:8px 10px;">{{ review.clientEmail ?? '—' }}</td>
            <td style="border:1px solid #eee;padding:8px 10px;">{{ review.artisanName ?? '—' }}</td>
            <td style="border:1px solid #eee;padding:8px 10px;text-align:center;font-weight:600;">
              {% if review.rating is defined and review.rating is not null %}
                {{ review.rating }}/5
              {% else %}
                —
              {% endif %}
            </td>
            <td style="border:1px solid #eee;padding:8px 10px;max-width:260px;">
              <span style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                {{ review.comment ?? '—' }}
              </span>
            </td>
            <td style="border:1px solid #eee;padding:8px 10px;">
              <span style="display:inline-block;padding:2px 6px;border-radius:999px;border:1px solid #ddd;font-size:11px;text-transform:uppercase;">
                {{ review.status ?? 'pending' }}
              </span>
            </td>
            <td style="border:1px solid #eee;padding:8px 10px;">
              {{ review.createdAt is defined and review.createdAt ? review.createdAt|date('Y-m-d H:i') : '—' }}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8" style="border:1px solid #eee;padding:12px 10px;color:#777;font-style:italic;">
              Aucun avis à afficher pour le moment.
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </section>

    <nav style="margin-top:16px;display:flex;gap:8px;align-items:center;">
      {% if pagination.page|default(1) > 1 %}
        <a href="?page={{ pagination.page - 1 }}&limit={{ pagination.limit|default(50) }}&status={{ filters.status|default('')|url_encode }}&client={{ filters.client|default('')|url_encode }}"
           style="padding:6px 10px;border-radius:8px;border:1px solid #222;text-decoration:none;color:#222;font-size:13px;">
          ← Précédent
        </a>
      {% endif %}

      {% if pagination.hasNext|default(false) %}
        <a href="?page={{ pagination.page + 1 }}&limit={{ pagination.limit|default(50) }}&status={{ filters.status|default('')|url_encode }}&client={{ filters.client|default('')|url_encode }}"
           style="padding:6px 10px;border-radius:8px;border:1px solid #222;text-decoration:none;color:#222;font-size:13px;">
          Suivant →
        </a>
      {% endif %}
    </nav>
  </main>
{% endblock %}
