{% extends 'base.html.twig' %}

{% block title %}Admin • Services{% endblock %}

{% block body %}
    <h1>Services publiés (status = active)</h1>

    <p class="text-muted mb-3">
        Total: <strong>{{ pagination.total }}</strong> •
        Page {{ pagination.page }} •
        Limite {{ pagination.limit }}
    </p>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Slug</th>
                <th>Artisan</th>
                <th>Tarif</th>
                <th>Statut</th>
                <th>Publié le</th>
                <th>Créé le</th>
            </tr>
            </thead>
            <tbody>
            {% for s in items %}
                <tr>
                    <td>{{ s.id }}</td>
                    <td>{{ s.title ?? '—' }}</td>
                    <td><span class="badge text-bg-light">{{ s.slug ?? '—' }}</span></td>
                    <td>{{ s.artisanProfile.displayName ?? '—' }}</td>
                    <td>
                        {% if s.unitAmount is not null and s.currency is not null %}
                            {{ s.unitAmount }} {{ s.currency }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>{{ s.status.value }}</td>
                    <td>{{ s.publishedAt ? s.publishedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>{{ s.createdAt ? s.createdAt|date('Y-m-d H:i') : '—' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-muted">Aucun service actif trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <nav class="d-flex gap-2 mt-3">
        {% if pagination.hasPrev %}
            <a class="btn btn-outline-secondary btn-sm"
               href="?page={{ pagination.page - 1 }}&limit={{ pagination.limit }}">
                ← Précédent
            </a>
        {% endif %}
        {% if pagination.hasNext %}
            <a class="btn btn-outline-secondary btn-sm"
               href="?page={{ pagination.page + 1 }}&limit={{ pagination.limit }}">
                Suivant →
            </a>
        {% endif %}
    </nav>
{% endblock %}
